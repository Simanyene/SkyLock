<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:presentation="clr-namespace:SkyLock.Presentation"
    x:Class="SkyLock.Presentation.GameplayPage"
    Title="Flight"
    Style="{StaticResource WelcomePageStyle}"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout
            Style="{StaticResource SignInLayoutStyle}">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8">

                <Button
                    x:Name="btnBack"
                    Grid.Column="0"
                    Text="Back"
                    TextColor="White"
                    Clicked="OnBackClicked"
                    Style="{StaticResource BackButtonStyle}" />

                <Label
                    x:Name="lblGameTitle"
                    Grid.Column="1"
                    Text="SkyLock"
                    TextColor="White"
                    Style="{StaticResource DifficultyNameStyle}"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />

                <Button
                    x:Name="btnPause"
                    Grid.Column="2"
                    Text="Pause"
                    TextColor="White"
                    Clicked="OnPauseClicked"
                    Style="{StaticResource BackButtonStyle}" />

            </Grid>

            <!-- Flight information -->
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="12">

                <Border Style="{StaticResource SignInFieldStyle}">
                    <VerticalStackLayout>

                        <Label
                            x:Name="lblAltitudeHeading"
                            Text="ALTITUDE"
                            TextColor="White"
                            Style="{StaticResource DifficultyDetailStyle}" />

                        <Label
                            x:Name="lblAltitude"
                            Text="10,000 FT"
                            TextColor="White"
                            Style="{StaticResource DifficultyNameStyle}" />

                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Column="1"
                    Style="{StaticResource SignInFieldStyle}">

                    <VerticalStackLayout>

                        <Label
                            x:Name="lblTimeHeading"
                            Text="TIME LEFT"
                            TextColor="White"
                            Style="{StaticResource DifficultyDetailStyle}" />

                        <Label
                            x:Name="lblTimeLeft"
                            Text="07:00"
                            TextColor="White"
                            Style="{StaticResource DifficultyNameStyle}" />

                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- Final 30-second warning -->
            <Grid Style="{StaticResource WarningSlotStyle}">
                <presentation:WarningView
                    x:Name="cvTimeWarning" />
            </Grid>

            <!-- Code instruction -->
            <Label
                x:Name="lblCodeInstruction"
                Text="ENTER 3-DIGIT OVERRIDE"
                TextColor="White"
                HorizontalTextAlignment="Center"
                Style="{StaticResource WelcomeTaglineStyle}" />

            <!-- Digit boxes -->
            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="8">

                <Border
                    x:Name="brdDigitOne"
                    Style="{StaticResource SignInFieldStyle}">
                    <Label
                        x:Name="lblDigitOne"
                        Text="_"
                        TextColor="White"
                        Style="{StaticResource DifficultyNameStyle}" />
                </Border>

                <Border
                    x:Name="brdDigitTwo"
                    Style="{StaticResource SignInFieldStyle}">
                    <Label
                        x:Name="lblDigitTwo"
                        Text="_"
                        TextColor="White"
                        Style="{StaticResource DifficultyNameStyle}" />
                </Border>

                <Border
                    x:Name="brdDigitThree"
                    Style="{StaticResource SignInFieldStyle}">
                    <Label
                        x:Name="lblDigitThree"
                        Text="_"
                        TextColor="White"
                        Style="{StaticResource DifficultyNameStyle}" />
                </Border>

                <Border
                    x:Name="brdDigitFour"
                    IsVisible="False"
                    Style="{StaticResource SignInFieldStyle}">
                    <Label
                        x:Name="lblDigitFour"
                        Text="_"
                        TextColor="White"
                        Style="{StaticResource DifficultyNameStyle}" />
                </Border>

                <Border
                    x:Name="brdDigitFive"
                    IsVisible="False"
                    Style="{StaticResource SignInFieldStyle}">
                    <Label
                        x:Name="lblDigitFive"
                        Text="_"
                        TextColor="White"
                        Style="{StaticResource DifficultyNameStyle}" />
                </Border>

            </HorizontalStackLayout>

            <!-- Hits and matches -->
            <Border Style="{StaticResource SignInFieldStyle}">
                <Grid ColumnDefinitions="*,*">

                    <Label
                        x:Name="lblHits"
                        Text="HITS: —"
                        TextColor="White"
                        Style="{StaticResource SignInRememberStyle}" />

                    <Label
                        x:Name="lblMatches"
                        Grid.Column="1"
                        Text="MATCHES: —"
                        TextColor="White"
                        HorizontalTextAlignment="End"
                        Style="{StaticResource SignInRememberStyle}" />

                </Grid>
            </Border>

            <!-- Game feedback -->
            <Label
                x:Name="lblGameMessage"
                Text="Enter a code using different digits."
                TextColor="White"
                HorizontalTextAlignment="Center"
                Style="{StaticResource SignInRememberStyle}" />

            <!-- Number keypad -->
            <Grid
                x:Name="grdKeypad"
                ColumnDefinitions="*,*,*"
                RowDefinitions="Auto,Auto,Auto,Auto"
                ColumnSpacing="8"
                RowSpacing="8">

                <!-- Numbers 0-9 are added in C# -->

                <Button
                    x:Name="btnDelete"
                    Grid.Row="3"
                    Grid.Column="0"
                    Text="Delete"
                    TextColor="White"
                    Clicked="OnDeleteClicked"
                    Style="{StaticResource WelcomeGuestStyle}" />

                <Button
                    x:Name="btnEnter"
                    Grid.Row="3"
                    Grid.Column="2"
                    Text="Enter"
                    TextColor="White"
                    Clicked="OnEnterClicked"
                    Style="{StaticResource WelcomeSignInStyle}" />

            </Grid>

            <!-- Guess history -->
            <Border Style="{StaticResource SignInFieldStyle}">
                <VerticalStackLayout Spacing="8">

                    <Label
                        x:Name="lblGuessHistoryHeading"
                        Text="GUESS HISTORY"
                        TextColor="White"
                        Style="{StaticResource WelcomeTaglineStyle}" />

                    <Label
                        x:Name="lblGuessCount"
                        Text="Guesses: 0"
                        TextColor="White"
                        Style="{StaticResource SignInRememberStyle}" />

                    <Label
                        x:Name="lblGuessHistory"
                        Text="Your guesses will appear here."
                        TextColor="White"
                        Style="{StaticResource DifficultyDetailStyle}" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
