<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SkyLock.Presentation.FlightRecordsPage"
    Title="Flight Records"
    Style="{StaticResource WelcomePageStyle}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
          Style="{StaticResource FlightRecordsLayoutStyle}">

        <Button x:Name="btnBack"
                Text="Back"
                Clicked="OnBackClicked"
                Style="{StaticResource BackButtonStyle}" />

        <Label x:Name="lblPageTitle"
               Grid.Row="1"
               Text="Flight Records"
               Style="{StaticResource DifficultyTitleStyle}" />

        <Picker x:Name="pckDifficulty"
                Grid.Row="2"
                Title="Choose difficulty"
                SelectedIndexChanged="OnDifficultyChanged"
                Style="{StaticResource FlightRecordsPickerStyle}">
            <Picker.Items>
                <x:String>Easy</x:String>
                <x:String>Medium</x:String>
                <x:String>Hard</x:String>
            </Picker.Items>
        </Picker>

        <Border Grid.Row="3"
                Style="{StaticResource SignInFieldStyle}">
            <Label x:Name="lblStatistics"
                   Text="Loading records..."
                   Style="{StaticResource FlightRecordsTextStyle}" />
        </Border>

        <CollectionView x:Name="clvFlightRecords"
                        Grid.Row="4"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <Label x:Name="lblEmptyRecords"
                       Text="No completed games for this difficulty yet."
                       Style="{StaticResource FlightRecordsTextStyle}" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource FlightRecordCardStyle}">
                        <Label x:Name="lblRecordDetails"
                               Text="{Binding .}"
                               Style="{StaticResource FlightRecordsTextStyle}" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</ContentPage>