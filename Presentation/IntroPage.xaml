<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="SkyLock.Presentation.IntroPage"
    Style="{StaticResource IntroPageStyle}">

    <Grid x:Name="grdIntroPage">
        <toolkit:MediaElement
            x:Name="medIntroVideo"
            Source="embed://Intro.mp4"
            Style="{StaticResource IntroVideoStyle}"
            ShouldAutoPlay="True"
            ShouldLoopPlayback="False"
            ShouldShowPlaybackControls="False"
            MediaEnded="OnIntroVideoEnded" />
    </Grid>

</ContentPage>