<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SkyLock.Presentation.ProfilePage"
    Title="Player Profile"
    Style="{StaticResource PlayerOptionsPageStyle}"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*"
          Style="{StaticResource PlayerOptionsLayoutStyle}">

        <Button x:Name="btnBack"
                Text="Back"
                Clicked="OnBackClicked"
                Style="{StaticResource PlayerOptionsBackStyle}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Style="{StaticResource PlayerOptionsStackStyle}">

                <Label x:Name="lblProfileTitle"
                       Text="Player Profile"
                       Style="{StaticResource PlayerOptionsTitleStyle}" />

                <Image x:Name="imgCurrentAvatar"
                       Style="{StaticResource PlayerAvatarPreviewStyle}" />

                <Label x:Name="lblProfileDescription"
                       Text="Choose your pilot avatar"
                       Style="{StaticResource PlayerOptionsTextStyle}" />

                <Label x:Name="lblProfileHint"
                       Text="Your selection is saved automatically on this device."
                       Style="{StaticResource PlayerOptionsTextStyle}" />

                <Border Style="{StaticResource PlayerOptionsCardStyle}">
                    <VerticalStackLayout
                        Style="{StaticResource PlayerOptionsStackStyle}">

                        <Label x:Name="lblAvatarHeading"
                               Text="Available avatars"
                               Style="{StaticResource PlayerOptionsHeadingStyle}" />

                        <Grid ColumnDefinitions="*,*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="12"
                              RowSpacing="12">

                            <ImageButton x:Name="btnAvatarMaleOne"
                                         Grid.Row="0"
                                         Grid.Column="0"
                                         Source="avatar_male1.png"
                                         StyleId="0"
                                         Clicked="OnAvatarClicked"
                                         SemanticProperties.Description="Select pilot avatar one"
                                         Style="{StaticResource PlayerAvatarButtonStyle}" />

                            <ImageButton x:Name="btnAvatarMaleTwo"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Source="avatar_male2.png"
                                         StyleId="1"
                                         Clicked="OnAvatarClicked"
                                         SemanticProperties.Description="Select pilot avatar two"
                                         Style="{StaticResource PlayerAvatarButtonStyle}" />

                            <ImageButton x:Name="btnAvatarFemaleOne"
                                         Grid.Row="0"
                                         Grid.Column="2"
                                         Source="avatar_female1.png"
                                         StyleId="2"
                                         Clicked="OnAvatarClicked"
                                         SemanticProperties.Description="Select pilot avatar three"
                                         Style="{StaticResource PlayerAvatarButtonStyle}" />

                            <ImageButton x:Name="btnAvatarFemaleTwo"
                                         Grid.Row="1"
                                         Grid.Column="0"
                                         Source="avatar_female2.png"
                                         StyleId="3"
                                         Clicked="OnAvatarClicked"
                                         SemanticProperties.Description="Select pilot avatar four"
                                         Style="{StaticResource PlayerAvatarButtonStyle}" />

                            <ImageButton x:Name="btnAvatarNeutral"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Source="avatar_neutral.png"
                                         StyleId="4"
                                         Clicked="OnAvatarClicked"
                                         SemanticProperties.Description="Select neutral avatar"
                                         Style="{StaticResource PlayerAvatarButtonStyle}" />

                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="lblProfileMessage"
                       Text=""
                       Style="{StaticResource PlayerOptionsTextStyle}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>