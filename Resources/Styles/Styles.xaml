<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
    </Style>

    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}"/>
        <Setter Property="SelectedIndicatorColor" Value="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray100}}"/>
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}" />
        <Setter Property="StrokeShape" Value="Rectangle"/>
        <Setter Property="StrokeThickness" Value="1"/>
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray200}}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray200}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Frame">
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
    </Style>

    <Style TargetType="ImageButton">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="BorderColor" Value="Transparent"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Span">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
    </Style>

    <Style TargetType="Label" x:Key="Headline">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="SubHeadline">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="ListView">
        <Setter Property="SeparatorColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}" />
        <Setter Property="RefreshControlColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                            <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="ProgressColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Gray500}" />
        <Setter Property="CancelButtonColor" Value="{StaticResource Gray500}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                            <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="SearchHandler">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Gray500}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                            <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Shadow">
        <Setter Property="Radius" Value="15" />
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Brush" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource White}}" />
        <Setter Property="Offset" Value="10,10" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
        <Setter Property="MaximumTrackColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
        <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="MinimumTrackColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"/>
                            <Setter Property="MaximumTrackColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"/>
                            <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="SwipeItem">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
        <Setter Property="ThumbColor" Value="{StaticResource White}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                            <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="On">
                        <VisualState.Setters>
                            <Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray200}}" />
                            <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Off">
                        <VisualState.Setters>
                            <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource SecondaryDarkText}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource SecondaryDarkText}}" />
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" />
        <Setter Property="Shell.UnselectedColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray200}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource Magenta}, Dark={StaticResource White}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource Magenta}, Dark={StaticResource White}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource White}}" />
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource White}}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource Magenta}, Dark={StaticResource White}}" />
        <Setter Property="UnselectedTabColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" />
        <Setter Property="SelectedTabColor" Value="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray200}}" />
    </Style>


    <!-- SkyLock loading page -->

    <Style x:Key="LoadingPageStyle" TargetType="ContentPage">
        <Setter Property="BackgroundColor"
                Value="{StaticResource SkyLockBackground}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="LoadingBackgroundStyle" TargetType="Image">
        <Setter Property="Aspect" Value="AspectFill" />
    </Style>

    <Style x:Key="LoadingContentStyle" TargetType="Grid">
        <Setter Property="Padding" Value="24,0,24,20" />
        <Setter Property="RowSpacing" Value="0" />
    </Style>

    <Style x:Key="LoadingTitleStyle" TargetType="Label">
        <Setter Property="TextColor"
                Value="{StaticResource SkyLockTitleColor}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="64" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="LoadingTaglineStyle" TargetType="Label">
        <Setter Property="TextColor"
                Value="{StaticResource SkyLockTaglineColor}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="1.5" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style x:Key="LoadingTrackStyle" TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{StaticResource SkyLockTrackColor}" />
        <Setter Property="Stroke"
                Value="{StaticResource SkyLockTrackBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="WidthRequest" Value="210" />
        <Setter Property="HeightRequest" Value="12" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalOptions" Value="Center" />

        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="6" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LoadingFillStyle" TargetType="BoxView">
        <Setter Property="Color"
                Value="{StaticResource SkyLockProgressColor}" />
        <Setter Property="WidthRequest" Value="0" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style x:Key="LoadingTextStyle" TargetType="Label">
        <Setter Property="TextColor"
                Value="{StaticResource SkyLockLoadingTextColor}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style x:Key="LoadingVersionStyle" TargetType="Label">
        <Setter Property="TextColor"
                Value="{StaticResource SkyLockVersionColor}" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>
    <!-- SkyLock intro page -->
    <Style x:Key="IntroPageStyle" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource Black}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="IntroVideoStyle" TargetType="toolkit:MediaElement">
        <Setter Property="Aspect" Value="AspectFit" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
    </Style>

    <!-- SkyLock home page -->
    <Style x:Key="HomePageStyle" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource HomeBackground}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="NavigationPage.HasNavigationBar" Value="False" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <Style x:Key="HomeLayoutStyle" TargetType="Grid">
        <Setter Property="Padding" Value="22,30,22,18" />
        <Setter Property="RowSpacing" Value="0" />
    </Style>

    <Style x:Key="HomeHeaderStyle" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="0" />
    </Style>

    <Style x:Key="HomeTitleStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource HomeTitleColor}" />
        <Setter Property="FontSize" Value="54" />
        <Setter Property="FontAttributes" Value="Bold,Italic" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
    </Style>

    <Style x:Key="HomeSubtitleStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource HomeTextColor}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="HomeButtonsStyle" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="10" />
        <Setter Property="Margin" Value="0,20,0,0" />
    </Style>

    <Style x:Key="HomeMenuButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource HomeMenuBackground}" />
        <Setter Property="TextColor" Value="{StaticResource HomeTextColor}" />
        <Setter Property="BorderColor" Value="{StaticResource HomeMenuBorder}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="MinimumWidthRequest" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="HomeFooterStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource HomeFooterText}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="CharacterSpacing" Value="1.5" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,28,0,0" />
    </Style>

    <!-- Start Flight uses the shared button style with a gradient -->
    <Style x:Key="HomeStartButtonStyle" TargetType="Button"
           BasedOn="{StaticResource HomeMenuButtonStyle}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource HomeStartTop}" Offset="0" />
                    <GradientStop Color="{StaticResource HomeStartBottom}" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SkyLock welcome page -->

    <Style x:Key="WelcomePageStyle" TargetType="ContentPage">
        <Setter Property="BackgroundColor"
            Value="{StaticResource WelcomeBackground}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
        <Setter Property="NavigationPage.HasNavigationBar" Value="False" />
    </Style>

    <Style x:Key="WelcomeBackgroundStyle" TargetType="Image">
        <Setter Property="Aspect" Value="AspectFill" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
    </Style>

    <Style x:Key="WelcomeLayoutStyle" TargetType="Grid">
        <Setter Property="Padding" Value="24,42,24,34" />
        <Setter Property="RowSpacing" Value="20" />
    </Style>

    <Style x:Key="WelcomeHeaderStyle" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style x:Key="WelcomeLogoStyle" TargetType="Label">
        <Setter Property="FontSize" Value="58" />
        <Setter Property="FontAttributes" Value="Bold,Italic" />
        <Setter Property="TextColor"
            Value="{StaticResource WelcomeTitle}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />

        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource WelcomeGlow}"
                    Offset="0,2"
                    Radius="12"
                    Opacity="0.7" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WelcomeTaglineStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor"
            Value="{StaticResource WelcomeText}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="WelcomeButtonsStyle" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="12" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style x:Key="WelcomeButtonStyle" TargetType="Button">
        <Setter Property="TextColor"
            Value="{StaticResource WelcomeText}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="MinimumHeightRequest" Value="56" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderColor"
            Value="{StaticResource WelcomeBorder}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style x:Key="WelcomeSignInStyle"
       TargetType="Button"
       BasedOn="{StaticResource WelcomeButtonStyle}">

        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop
                    Color="{StaticResource WelcomeSignInTop}"
                    Offset="0" />
                    <GradientStop
                    Color="{StaticResource WelcomeSignInMiddle}"
                    Offset="0.55" />
                    <GradientStop
                    Color="{StaticResource WelcomeSignInBottom}"
                    Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>

        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource WelcomeGlow}"
                    Offset="0,2"
                    Radius="10"
                    Opacity="0.45" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WelcomeGuestStyle"
       TargetType="Button"
       BasedOn="{StaticResource WelcomeButtonStyle}">

        <Setter Property="FontSize" Value="15" />

        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop
                    Color="{StaticResource WelcomeGuestTop}"
                    Offset="0" />
                    <GradientStop
                    Color="{StaticResource WelcomeGuestBottom}"
                    Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sign-in page -->

    <Style x:Key="SignInOverlayStyle" TargetType="BoxView">
        <Setter Property="Color"
            Value="{StaticResource SignInOverlay}" />
        <Setter Property="Opacity" Value="0.88" />
        <Setter Property="InputTransparent" Value="True" />
    </Style>

    <Style x:Key="SignInLayoutStyle" TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="24,36,24,24" />
        <Setter Property="Spacing" Value="16" />
    </Style>

    <Style x:Key="SignInFieldStyle" TargetType="Border">
        <Setter Property="BackgroundColor"
            Value="{StaticResource SignInFieldBackground}" />
        <Setter Property="Stroke"
            Value="{StaticResource WelcomeBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,4" />

        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SignInEntryStyle" TargetType="Entry">
        <Setter Property="TextColor"
            Value="{StaticResource WelcomeText}" />
        <Setter Property="PlaceholderColor"
            Value="{StaticResource SignInPlaceholder}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="IsTextPredictionEnabled" Value="False" />
        <Setter Property="IsSpellCheckEnabled" Value="False" />
    </Style>

    <Style x:Key="SignInLinkStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor"
            Value="{StaticResource WelcomeTitle}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style x:Key="SignInCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Color"
            Value="{StaticResource WelcomeBorder}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="SignInRememberStyle" TargetType="Label">
        <Setter Property="TextColor"
            Value="{StaticResource WelcomeText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="SignInErrorStyle" TargetType="Label">
        <Setter Property="TextColor"
            Value="{StaticResource SignInError}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Difficulty page -->
    <Style x:Key="DifficultyLayoutStyle" TargetType="Grid">
        <Setter Property="Padding" Value="24,12,24,24" />
        <Setter Property="RowSpacing" Value="16" />
    </Style>

    <Style x:Key="DifficultyBackStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <Style x:Key="DifficultyTitleStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="25" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <Style x:Key="DifficultyCardsStyle" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="14" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="DifficultyCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="MinimumHeightRequest" Value="100" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14" />
            </Setter.Value>
        </Setter>

        <!-- Highlight the difficulty selected by the player. -->
        <Setter Property="VisualStateManager.VisualStateGroups">
            <Setter.Value>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="SelectionStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="Stroke"
                                        Value="{StaticResource White}" />
                                <Setter Property="StrokeThickness" Value="4" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DifficultyEasyStyle"
       TargetType="Border"
       BasedOn="{StaticResource DifficultyCardStyle}">
        <Setter Property="BackgroundColor"
            Value="{StaticResource DifficultyEasyBackground}" />
        <Setter Property="Stroke"
            Value="{StaticResource DifficultyEasyBorder}" />
    </Style>

    <Style x:Key="DifficultyMediumStyle"
       TargetType="Border"
       BasedOn="{StaticResource DifficultyCardStyle}">
        <Setter Property="BackgroundColor"
            Value="{StaticResource DifficultyMediumBackground}" />
        <Setter Property="Stroke"
            Value="{StaticResource DifficultyMediumBorder}" />
    </Style>

    <Style x:Key="DifficultyHardStyle"
       TargetType="Border"
       BasedOn="{StaticResource DifficultyCardStyle}">
        <Setter Property="BackgroundColor"
            Value="{StaticResource DifficultyHardBackground}" />
        <Setter Property="Stroke"
            Value="{StaticResource DifficultyHardBorder}" />
    </Style>

    <Style x:Key="DifficultyCardGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="18" />
    </Style>

    <Style x:Key="DifficultyIconStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="DifficultyNameStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="21" />
    </Style>

    <Style x:Key="DifficultyDetailStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="PlainPageStyle" TargetType="ContentPage">
        <Setter Property="BackgroundColor"
            Value="{StaticResource AppPageBackground}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="NavigationPage.HasNavigationBar" Value="False" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <Style x:Key="BackButtonStyle" TargetType="Button">
        <Setter Property="TextColor"
            Value="{StaticResource HomeTextColor}" />
        <Setter Property="BackgroundColor"
            Value="{StaticResource HomeMenuBackground}" />
        <Setter Property="BorderColor"
            Value="{StaticResource HomeMenuBorder}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="WidthRequest" Value="76" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <!-- Critical-time warning -->
    <Style x:Key="GameWarningBorderStyle"
       TargetType="Border">
        <Setter Property="BackgroundColor"
            Value="{StaticResource WarningBackground}" />
        <Setter Property="Stroke"
            Value="{StaticResource WarningBorderColor}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Padding" Value="12" />

        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameWarningTextStyle"
       TargetType="Label">
        <Setter Property="TextColor"
            Value="{StaticResource White}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- Reserve space so the keypad does not move when warning appears. -->
    <Style x:Key="WarningSlotStyle"
       TargetType="Grid">
        <Setter Property="MinimumHeightRequest" Value="84" />
    </Style>

    <Style x:Key="WarningBannerStyle"
       TargetType="Border">
        <Setter Property="BackgroundColor"
            Value="{StaticResource Black}" />
        <Setter Property="Stroke" Value="OrangeRed" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Padding" Value="10" />

        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WarningCriticalBannerStyle"
       TargetType="Border"
       BasedOn="{StaticResource WarningBannerStyle}">
        <Setter Property="Stroke"
            Value="{StaticResource WarningBorderColor}" />
        <Setter Property="StrokeThickness" Value="3" />
    </Style>

    <Style x:Key="WarningBannerTextStyle"
       TargetType="Label">
        <Setter Property="TextColor"
            Value="{StaticResource White}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- How to Play page -->
    <Style x:Key="HowToPlayLayoutStyle"
       TargetType="Grid">
        <Setter Property="Padding" Value="20" />
        <Setter Property="RowSpacing" Value="16" />
    </Style>

    <Style x:Key="HowToPlayStepsStyle"
       TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="16" />
        <Setter Property="Padding" Value="0,0,0,20" />
    </Style>

    <Style x:Key="HowToPlayCardStyle"
       TargetType="Border">
        <Setter Property="BackgroundColor"
            Value="{StaticResource SignInFieldBackground}" />
        <Setter Property="Stroke"
            Value="{StaticResource WelcomeBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HowToPlayCardContentStyle"
       TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="10" />
    </Style>

    <Style x:Key="HowToPlayStepHeadingStyle"
       TargetType="Label">
        <Setter Property="TextColor"
            Value="{StaticResource WelcomeTitle}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="HowToPlayBodyStyle"
       TargetType="Label">
        <Setter Property="TextColor"
            Value="{StaticResource WelcomeText}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="HowToPlayExampleStyle"
       TargetType="Label"
       BasedOn="{StaticResource HowToPlayBodyStyle}">
        <Setter Property="TextColor"
            Value="{StaticResource WelcomeTitle}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,8" />
    </Style>

    <!-- Flight Records page -->
    <Style x:Key="FlightRecordsLayoutStyle"
       TargetType="Grid">
        <Setter Property="Padding" Value="20" />
        <Setter Property="RowSpacing" Value="16" />
    </Style>

    <Style x:Key="FlightRecordsPickerStyle"
       TargetType="Picker">
        <Setter Property="TextColor"
            Value="{StaticResource WelcomeText}" />
        <Setter Property="TitleColor"
            Value="{StaticResource WelcomeTitle}" />
        <Setter Property="BackgroundColor"
            Value="{StaticResource SignInFieldBackground}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="FlightRecordsTextStyle"
       TargetType="Label">
        <Setter Property="TextColor"
            Value="{StaticResource WelcomeText}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="FlightRecordCardStyle"
       TargetType="Border"
       BasedOn="{StaticResource SignInFieldStyle}">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Side menu text: always white on the dark menu -->
    <Style x:Key="SideMenuTextStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource WelcomeText}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
    </Style>

    <!-- Side menu -->
    <Style x:Key="SideMenuPanelStyle"
       TargetType="Border">

        <Setter Property="BackgroundColor"
            Value="{StaticResource WelcomeBackground}" />

        <Setter Property="Stroke"
            Value="{StaticResource HomeMenuBorder}" />

        <Setter Property="StrokeThickness"
            Value="1" />

        <Setter Property="Padding"
            Value="20" />

        <Setter Property="HorizontalOptions"
            Value="Fill" />

        <Setter Property="VerticalOptions"
            Value="Fill" />

    </Style>

    <!-- Shared profile and settings styles -->

    <Style x:Key="PlayerOptionsPageStyle"
       TargetType="ContentPage">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor"
            Value="{AppThemeBinding Light=#EDF5FC, Dark=#03162D}" />
    </Style>

    <Style x:Key="PlayerOptionsLayoutStyle"
       TargetType="Grid">
        <Setter Property="Padding" Value="20,12,20,24" />
        <Setter Property="RowSpacing" Value="16" />
    </Style>

    <Style x:Key="PlayerOptionsStackStyle"
       TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="16" />
    </Style>

    <Style x:Key="PlayerOptionsTitleStyle"
       TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor"
            Value="{AppThemeBinding Light=#073B5B, Dark=#C5F3FF}" />
    </Style>

    <Style x:Key="PlayerOptionsHeadingStyle"
       TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor"
            Value="{AppThemeBinding Light=#10283F, Dark=#FFFFFF}" />
    </Style>

    <Style x:Key="PlayerOptionsTextStyle"
       TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor"
            Value="{AppThemeBinding Light=#40576D, Dark=#BCD4E7}" />
    </Style>

    <Style x:Key="PlayerOptionsCardStyle"
       TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke"
            Value="{AppThemeBinding Light=#A7C8DE, Dark=#24516F}" />
        <Setter Property="BackgroundColor"
            Value="{AppThemeBinding Light=#FFFFFF, Dark=#082D49}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayerOptionsButtonStyle"
       TargetType="Button">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BackgroundColor" Value="#007BB8" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="PlayerOptionsBackStyle"
       TargetType="Button"
       BasedOn="{StaticResource PlayerOptionsButtonStyle}">
        <Setter Property="Text" Value="Back" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="WidthRequest" Value="80" />
    </Style>

    <Style x:Key="PlayerOptionsPickerStyle"
       TargetType="Picker">
        <Setter Property="TitleColor"
            Value="{AppThemeBinding Light=#40576D, Dark=#BCD4E7}" />
        <Setter Property="TextColor"
            Value="{AppThemeBinding Light=#10283F, Dark=#FFFFFF}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style x:Key="PlayerOptionsSwitchStyle"
       TargetType="Switch">
        <Setter Property="OnColor" Value="#007BB8" />
        <Setter Property="ThumbColor" Value="#4FC3F7" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="PlayerAvatarPreviewStyle"
       TargetType="Image">
        <Setter Property="WidthRequest" Value="110" />
        <Setter Property="HeightRequest" Value="110" />
        <Setter Property="Aspect" Value="AspectFit" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="PlayerAvatarButtonStyle"
       TargetType="ImageButton">
        <Setter Property="HeightRequest" Value="76" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="Aspect" Value="AspectFit" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BackgroundColor"
            Value="{AppThemeBinding Light=#EDF5FC, Dark=#03162D}" />

        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BorderColor"
                                Value="Transparent" />
                            <Setter Property="BorderWidth"
                                Value="2" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="BorderColor"
                                Value="#00BFFF" />
                            <Setter Property="BorderWidth"
                                Value="4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Forgot Password Page -->

    <Style x:Key="ForgotPasswordLayoutStyle"
       TargetType="VerticalStackLayout"
       BasedOn="{StaticResource SignInLayoutStyle}">
        <Setter Property="Spacing" Value="16" />
    </Style>

    <Style x:Key="ForgotPasswordLogoStyle"
       TargetType="Label"
       BasedOn="{StaticResource WelcomeLogoStyle}">
        <Setter Property="Margin" Value="0,0,0,35" />
    </Style>

    <Style x:Key="ForgotPasswordErrorStyle"
       TargetType="Label"
       BasedOn="{StaticResource SignInErrorStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

</ResourceDictionary>
